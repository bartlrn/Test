        private void SetPanelSize(out int width, out int height)
        {
            switch (PanelSize)
            {
                case PanelSize.Tiny:
                    width = 150;
                    height = 300;
                    break;
                case PanelSize.Small:
                    width = 200;
                    height = 400;
                    break;
                case PanelSize.Normal:
                    width = 300;
                    height = 500;
                    break;
                case PanelSize.Large:
                    width = 400;
                    height = 600;
                    break;
                default:
                    width = 200;
                    height = 400;
                    break;
            }
        }

        private void BuyButtonClicked(ButtonClickEventArgs e)
        {
            double positionSize = double.Parse(_positionSizeTextBox.Text);
            double tpDistance = double.Parse(_tpTextBox.Text);
            double slDistance = double.Parse(_slTextBox.Text);

            ExecuteMarketOrder(TradeType.Buy, SymbolName, Symbol.QuantityToVolumeInUnits(positionSize), "ManualBuy", slDistance, tpDistance, null);
        }

        private void SellButtonClicked(ButtonClickEventArgs e)
        {
            double positionSize = double.Parse(_positionSizeTextBox.Text);
            double tpDistance = double.Parse(_tpTextBox.Text);
            double slDistance = double.Parse(_slTextBox.Text);

            ExecuteMarketOrder(TradeType.Sell, SymbolName, Symbol.QuantityToVolumeInUnits(positionSize), "ManualSell", slDistance, tpDistance, null);
        }

        private void CloseBuyButtonClicked(ButtonClickEventArgs e)
        {
            var buyPositions = Positions.Where(p => p.TradeType == TradeType.Buy && p.SymbolName == SymbolName);
            foreach (var position in buyPositions)
            {
                ClosePosition(position);
            }
        }

        private void CloseSellButtonClicked(ButtonClickEventArgs e)
        {
            var sellPositions = Positions.Where(p => p.TradeType == TradeType.Sell && p.SymbolName == SymbolName);
            foreach (var position in sellPositions)
            {
                ClosePosition(position);
            }
        }

        private void CloseAllButtonClicked(ButtonClickEventArgs e)
        {
            CloseAllPositions();
        }

        private void InitializeIndicators()
        {
            _shortMA = CreateMovingAverage(ShortPeriod, ShortPeriodMAType);
            _longMA = CreateMovingAverage(LongPeriod, LongPeriodMAType);
            _trailingStopMA = CreateMovingAverage(TrailingStopMAPeriod, TrailingStopMAType);

            if (UseInnerTimeframeMA)
            {
                _innerShortMA = CreateInnerTimeframeMovingAverage(InnerTimeframeShortPeriod, InnerTimeframeShortMAType, InnerTimeframe);
                _innerLongMA = CreateInnerTimeframeMovingAverage(InnerTimeframeLongPeriod, InnerTimeframeLongMAType, InnerTimeframe);
            }

            _ao = Indicators.AwesomeOscillator();
            _macd = Indicators.MacdCrossOver(MACDFastPeriod, MACDSlowPeriod, MACDSignalPeriod);
            _rsi = Indicators.RelativeStrengthIndex(Bars.ClosePrices, RSIPeriod);
        }

        private MovingAverage CreateMovingAverage(int period, MovingAverageType type)
        {
            return type switch
            {
                MovingAverageType.EMA => Indicators.ExponentialMovingAverage(Bars.ClosePrices, period),
                MovingAverageType.WWS => Indicators.WellesWilderSmoothing(Bars.ClosePrices, period),
                MovingAverageType.HMA => Indicators.HullMovingAverage(Bars.ClosePrices, period),
                MovingAverageType.SMA => Indicators.SimpleMovingAverage(Bars.ClosePrices, period),
                MovingAverageType.TMA => Indicators.TriangularMovingAverage(Bars.ClosePrices, period),
                MovingAverageType.WMA => Indicators.WeightedMovingAverage(Bars.ClosePrices, period),
                _ => throw new ArgumentException("Nieprawidłowy typ średniej kroczącej"),
            };
        }

        private MovingAverage CreateInnerTimeframeMovingAverage(int period, MovingAverageType type, InnerTimeframeOptions timeframe)
        {
            var innerTimeframeBars = MarketData.GetBars(GetTimeFrameFromOptions(timeframe));
            return type switch
            {
                MovingAverageType.EMA => Indicators.ExponentialMovingAverage(innerTimeframeBars.ClosePrices, period),
                MovingAverageType.WWS => Indicators.WellesWilderSmoothing(innerTimeframeBars.ClosePrices, period),
                MovingAverageType.HMA => Indicators.HullMovingAverage(innerTimeframeBars.ClosePrices, period),
                MovingAverageType.SMA => Indicators.SimpleMovingAverage(innerTimeframeBars.ClosePrices, period),
                MovingAverageType.TMA => Indicators.TriangularMovingAverage(innerTimeframeBars.ClosePrices, period),
                MovingAverageType.WMA => Indicators.WeightedMovingAverage(innerTimeframeBars.ClosePrices, period),
                _ => throw new ArgumentException("Nieprawidłowy typ średniej kroczącej"),
            };
        }

        private TimeFrame GetTimeFrameFromOptions(InnerTimeframeOptions timeframe)
        {
            return timeframe switch
            {
                InnerTimeframeOptions.M1 => TimeFrame.Minute,
                InnerTimeframeOptions.M5 => TimeFrame.Minute5,
                InnerTimeframeOptions.M15 => TimeFrame.Minute15,
                InnerTimeframeOptions.M30 => TimeFrame.Minute30,
                InnerTimeframeOptions.H1 => TimeFrame.Hour,
                InnerTimeframeOptions.H4 => TimeFrame.Hour4,
                InnerTimeframeOptions.D1 => TimeFrame.Daily,
                InnerTimeframeOptions.W1 => TimeFrame.Weekly,
                _ => throw new ArgumentException("Nieprawidłowy TimeFrame"),
            };
        }

        private void ValidateParameters()
        {
            if (ShortPeriod <= 0 || LongPeriod <= 0 || TrailingStopMAPeriod <= 0)
                throw new ArgumentException("Okresy MA muszą być dodatnimi liczbami całkowitymi.");

            if (RSIOverboughtLevel <= RSIOversoldLevel)
                throw new ArgumentException("Poziom wykupienia RSI musi być większy od poziomu wyprzedania RSI.");

            if (CoolDownPeriod <= 0)
                throw new ArgumentException("CoolDownPeriod musi być dodatnią liczbą całkowitą.");

            if (TrailingStopDistance <= 0 || TrailingStopMADistance <= 0 || SLDistance <= 0 || TPDistancePips <= 0)
                throw new ArgumentException("Parametry odległości muszą być dodatnimi liczbami całkowitymi.");
        }

        protected override void OnTick()
        {
            try
            {
                if (Server.Time.Date != _currentDay)
                {
                    _currentDay = Server.Time.Date;
                    ResetDailyVariables();
                }

                if (!CanOpenPosition())
                    return;

                if (EnableDailyLossLimit && HasReachedDailyLossLimit())
                    return;

                double shortMAValue = _shortMA.Result.LastValue;
                double longMAValue = _longMA.Result.LastValue;
                var price = Bars.ClosePrices.LastValue;
                var aoCurrent = _ao.Result.LastValue;
                var aoPrevious = _ao.Result.Last(1);
                var macdHistogram = _macd.Histogram.LastValue;
                var rsiValue = _rsi.Result.LastValue;

                bool aoConditionLong = !UseAOFilter || (aoCurrent > aoPrevious);
                bool aoConditionShort = !UseAOFilter || (aoCurrent < aoPrevious);

                if (AOMustBeAboveBelowZero)
                {
                    aoConditionLong = aoConditionLong && aoCurrent > 0;
                    aoConditionShort = aoConditionShort && aoCurrent < 0;
                }

                bool macdConditionLong = !UseMACDFilter || (macdHistogram > 0);
                bool macdConditionShort = !UseMACDFilter || (macdHistogram < 0);

                bool rsiConditionLong = !UseRSIFilter || (rsiValue < RSIOversoldLevel);
                bool rsiConditionShort = !UseRSIFilter || (rsiValue > RSIOverboughtLevel);

                bool innerTimeframeConditionLong = true;
                bool innerTimeframeConditionShort = true;

                if (UseInnerTimeframeMA)
                {
                    var innerShortMAValue = _innerShortMA.Result.LastValue;
                    var innerLongMAValue = _innerLongMA.Result.LastValue;

                    innerTimeframeConditionLong = innerShortMAValue > innerLongMAValue;
                    innerTimeframeConditionShort = innerShortMAValue < innerLongMAValue;
                }

                Log($"OnTick: shortMA={shortMAValue}, longMA={longMAValue}, price={price}");

                if (shortMAValue > longMAValue && innerTimeframeConditionLong)
                {
                    if (price > shortMAValue && price <= shortMAValue + DistanceFromShortMAToOpen * Symbol.PipSize)
                    {
                        if (aoConditionLong && macdConditionLong && rsiConditionLong && Positions.Count(p => p.Label == LabelPrefix + "ShortMA") < MaxPositionsShortMA)
                        {
                            OpenPosition(TradeType.Buy, LabelPrefix + "ShortMA", price, PositionSizeShortMA);
                        }
                    }

                    if (price > longMAValue && price <= longMAValue + DistanceFromLongMAToOpen * Symbol.PipSize)
                    {
                        if (aoConditionLong && macdConditionLong && rsiConditionLong && Positions.Count(p => p.Label == LabelPrefix + "LongMA") < MaxPositionsLongMA)
                        {
                            OpenPosition(TradeType.Buy, LabelPrefix + "LongMA", price, PositionSizeLongMA);
                        }
                    }
                }
                else if (shortMAValue < longMAValue && innerTimeframeConditionShort)
                {
                    if (price < shortMAValue && price >= shortMAValue - DistanceFromShortMAToOpen * Symbol.PipSize)
                    {
                        if (aoConditionShort && macdConditionShort && rsiConditionShort && Positions.Count(p => p.Label == LabelPrefix + "ShortMA") < MaxPositionsShortMA)
                        {
                            OpenPosition(TradeType.Sell, LabelPrefix + "ShortMA", price, PositionSizeShortMA);
                        }
                    }

                    if (price < longMAValue && price >= longMAValue - DistanceFromLongMAToOpen * Symbol.PipSize)
                    {
                        if (aoConditionShort && macdConditionShort && rsiConditionShort && Positions.Count(p => p.Label == LabelPrefix + "LongMA") < MaxPositionsLongMA)
                        {
                            OpenPosition(TradeType.Sell, LabelPrefix + "LongMA", price, PositionSizeLongMA);
                        }
                    }
                }

                CheckGlobalStopLoss();
                SetTakeProfit();

                if (EnableTrailingStop)
                {
                    SetTrailingStop();
                }
                else if (MoveSLToBE)
                {
                    SetBreakEvenStop();
                }

                UpdateProfitText(); // Update profit text during trading time
                UpdateIndicatorStates(); // Update indicator states on each tick
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas przetwarzania ticku", ex);
            }
        }

        private void UpdateProfitText()
        {
            double profit = Account.Equity - _initialBalance;
            string profitText = $"Profit: {profit:F2} $";
            _profitText.Text = profitText;
        }

        private void UpdateIndicatorStates()
        {
            if (UseAOFilter)
            {
                var aoCurrent = _ao.Result.LastValue;
                _aoText.Text = $"AO: {aoCurrent:F2}";
                _aoText.ForegroundColor = aoCurrent > _ao.Result.Last(1) ? "Green" : "Red";
            }

            if (UseMACDFilter)
            {
                var macdHistogram = _macd.Histogram.LastValue;
                _macdText.Text = $"MACD: {macdHistogram:F2}";
                _macdText.ForegroundColor = macdHistogram > 0 ? "Green" : "Red"; // Kolor oparty na wartości histogramu MACD
            }

            if (UseRSIFilter)
            {
                var rsiValue = _rsi.Result.LastValue;
                _rsiText.Text = $"RSI: {rsiValue:F2}";
                _rsiText.ForegroundColor = rsiValue > _rsi.Result.Last(1) ? "Green" : "Red";
            }
        }

        private void ResetDailyVariables()
        {
            _startingDayBalance = Account.Balance;
            _dailyLossLimit = _startingDayBalance * (DailyLossLimitPercentage / 100);
            _lastTradeTime = DateTime.MinValue;
            _globalStopLossTriggered = false;
            Log($"Resetowanie zmiennych dziennych: _dailyLossLimit={_dailyLossLimit}, _lastTradeTime={_lastTradeTime}");
        }

        private bool CanOpenPosition()
        {
            var canOpen = (DateTime.UtcNow - _lastTradeTime).TotalSeconds >= CoolDownPeriod;
            Log($"CanOpenPosition: canOpen={canOpen}, lastTradeTime={_lastTradeTime}, currentTime={DateTime.UtcNow}");
            return canOpen;
        }

        private void OpenPosition(TradeType tradeType, string label, double price, double positionSize)
        {
            try
            {
                var volume = Symbol.QuantityToVolumeInUnits(positionSize);
                var stopLossPrice = tradeType == TradeType.Buy ? price - SLDistance * Symbol.PipSize : price + SLDistance * Symbol.PipSize;

                Log($"Otwieram pozycję {tradeType} na {label} przy cenie {price} z wolumenem {volume} i SL {stopLossPrice}");

                var result = ExecuteMarketOrder(tradeType, SymbolName, volume, label, stopLossPrice, 0);

                if (result.IsSuccessful)
                {
                    _lastTradeTime = DateTime.UtcNow;
                    Log($"Pozycja {tradeType} otwarta na {label} przy cenie {price} z wolumenem {volume} i SL {stopLossPrice}");

                    if (result.Position.StopLoss != stopLossPrice)
                    {
                        Log($"Ustawienie SL ręcznie dla pozycji {result.Position.Id}");
                        ModifyPosition(result.Position, stopLossPrice, result.Position.TakeProfit);
                    }
                }
                else
                {
                    Log($"Nie udało się otworzyć pozycji {tradeType} na {label} przy cenie {price} z wolumenem {volume} i SL {stopLossPrice}");
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas otwierania pozycji", ex);
            }
        }

        private bool HasReachedDailyLossLimit()
        {
            try
            {
                var currentEquity = Account.Balance + Account.UnrealizedNetProfit;
                if (_startingDayBalance - currentEquity >= _dailyLossLimit)
                {
                    CloseAllPositions();
                    Log("Limit dziennej straty osiągnięty. Wszystkie pozycje zostały zamknięte.");
                    return true;
                }
                return false;
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas sprawdzania limitu dziennej straty", ex);
                return false;
            }
        }

        private void CheckGlobalStopLoss()
        {
            try
            {
                if (_globalStopLossTriggered)
                    return;

                var maxLoss = _initialBalance * (GlobalSLPercentage / 100);
                var currentEquity = Account.Balance + Account.UnrealizedNetProfit;
                if (_initialBalance - currentEquity >= maxLoss)
                {
                    Log("Globalny stop loss osiągnięty. Zamykanie wszystkich pozycji.");
                    CloseAllPositions();
                    _globalStopLossTriggered = true;
                    Log("Wszystkie pozycje zostały zamknięte przez globalny stop loss.");
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas sprawdzania globalnego stop loss", ex);
            }
        }

        private void SetTakeProfit()
        {
            try
            {
                if (TakeProfitType == TPType.Dollar && TPBasedOnTotalProfit)
                {
                    double totalProfit = Positions.Where(p => p.SymbolName == SymbolName).Sum(p => p.GrossProfit);

                    if (totalProfit >= TPAmount)
                    {
                        CloseAllPositions();
                        Log($"Wszystkie pozycje zamknięte po osiągnięciu TP w dolarach: {TPAmount}");
                        return;
                    }
                }

                foreach (var position in Positions)
                {
                    if (position.SymbolName == SymbolName)
                    {
                        switch (TakeProfitType)
                        {
                            case TPType.Pips:
                                SetTakeProfitPips(position);
                                break;
                            case TPType.Dollar:
                                if (!TPBasedOnTotalProfit)
                                {
                                    SetTakeProfitDollar(position);
                                }
                                break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania take profit", ex);
            }
        }

        private void SetTakeProfitPips(Position position)
        {
            try
            {
                double takeProfitPrice = position.EntryPrice + (position.TradeType == TradeType.Buy ? TPDistancePips : -TPDistancePips) * Symbol.PipSize;

                if ((position.TradeType == TradeType.Buy && Symbol.Bid >= takeProfitPrice) ||
                    (position.TradeType == TradeType.Sell && Symbol.Ask <= takeProfitPrice))
                {
                    ClosePosition(position);
                    Log($"Pozycja zamknięta na poziomie TP w pipsach: {takeProfitPrice}");
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania TP w pipsach", ex);
            }
        }

        private void SetTakeProfitDollar(Position position)
        {
            try
            {
                double currentProfit = position.GrossProfit;
                if (currentProfit >= TPAmount)
                {
                    ClosePosition(position);
                    Log($"Pozycja zamknięta na poziomie TP w dolarach: {TPAmount}");
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania TP w dolarach", ex);
            }
        }

        private void SetTrailingStop()
        {
            try
            {
                foreach (var position in Positions)
                {
                    if (position.SymbolName == SymbolName)
                    {
                        if (TrailingStopType == TrailingStopType.FixedDistance)
                        {
                            SetFixedDistanceTrailingStop(position);
                        }
                        else if (TrailingStopType == TrailingStopType.MovingAverage)
                        {
                            SetMovingAverageTrailingStop(position);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania trailing stop", ex);
            }
        }

        private void SetFixedDistanceTrailingStop(Position position)
        {
            try
            {
                double distance = 0;
                double newStopLossPrice = 0;
                double initialStopLoss = position.EntryPrice + (position.TradeType == TradeType.Buy ? -SLDistance : SLDistance) * Symbol.PipSize;

                if (position.TradeType == TradeType.Buy)
                {
                    distance = Symbol.Bid - position.EntryPrice;

                    if (distance >= TrailingStopDistance * Symbol.PipSize)
                    {
                        newStopLossPrice = Symbol.Bid - TrailingStopDistance * Symbol.PipSize;

                        if (newStopLossPrice > position.StopLoss || position.StopLoss == null)
                        {
                            ModifyPosition(position, newStopLossPrice, position.TakeProfit);
                            Log($"Trailing stop dostosowany dla pozycji BUY do {newStopLossPrice}");
                        }
                    }
                    else if (position.StopLoss == null || position.StopLoss < initialStopLoss)
                    {
                        ModifyPosition(position, initialStopLoss, position.TakeProfit);
                        Log($"Początkowy stop loss ustawiony dla pozycji BUY do {initialStopLoss}");
                    }
                }
                else if (position.TradeType == TradeType.Sell)
                {
                    distance = position.EntryPrice - Symbol.Ask;

                    if (distance >= TrailingStopDistance * Symbol.PipSize)
                    {
                        newStopLossPrice = Symbol.Ask + TrailingStopDistance * Symbol.PipSize;

                        if (newStopLossPrice < position.StopLoss || position.StopLoss == null)
                        {
                            ModifyPosition(position, newStopLossPrice, position.TakeProfit);
                            Log($"Trailing stop dostosowany dla pozycji SELL do {newStopLossPrice}");
                        }
                    }
                    else if (position.StopLoss == null || position.StopLoss > initialStopLoss)
                    {
                        ModifyPosition(position, initialStopLoss, position.TakeProfit);
                        Log($"Początkowy stop loss ustawiony dla pozycji SELL do {initialStopLoss}");
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania trailing stop na stałą odległość", ex);
            }
        }

        private void SetMovingAverageTrailingStop(Position position)
        {
            try
            {
                double maValue = _trailingStopMA.Result.LastValue;
                double newStopLossPrice = 0;
                double initialStopLoss = position.EntryPrice + (position.TradeType == TradeType.Buy ? -SLDistance : SLDistance) * Symbol.PipSize;

                if (position.TradeType == TradeType.Buy)
                {
                    if (Symbol.Bid - position.EntryPrice >= TrailingStopDistance * Symbol.PipSize && Symbol.Bid > position.EntryPrice)
                    {
                        newStopLossPrice = maValue - TrailingStopMADistance * Symbol.PipSize;

                        if (newStopLossPrice > position.StopLoss || position.StopLoss == null)
                        {
                            ModifyPosition(position, newStopLossPrice, position.TakeProfit);
                            Log($"Trailing stop dostosowany do MA dla pozycji BUY do {newStopLossPrice}");
                        }
                    }
                    else if (position.StopLoss == null || position.StopLoss < initialStopLoss)
                    {
                        ModifyPosition(position, initialStopLoss, position.TakeProfit);
                        Log($"Początkowy stop loss ustawiony dla pozycji BUY do {initialStopLoss}");
                    }
                }
                else if (position.TradeType == TradeType.Sell)
                {
                    if (position.EntryPrice - Symbol.Ask >= TrailingStopDistance * Symbol.PipSize && Symbol.Ask < position.EntryPrice)
                    {
                        newStopLossPrice = maValue + TrailingStopMADistance * Symbol.PipSize;

                        if (newStopLossPrice < position.StopLoss || position.StopLoss == null)
                        {
                            ModifyPosition(position, newStopLossPrice, position.TakeProfit);
                            Log($"Trailing stop dostosowany do MA dla pozycji SELL do {newStopLossPrice}");
                        }
                    }
                    else if (position.StopLoss == null || position.StopLoss > initialStopLoss)
                    {
                        ModifyPosition(position, initialStopLoss, position.TakeProfit);
                        Log($"Początkowy stop loss ustawiony dla pozycji SELL do {initialStopLoss}");
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania trailing stop na średnią kroczącą", ex);
            }
        }

        private void SetBreakEvenStop()
        {
            try
            {
                foreach (var position in Positions)
                {
                    if (position.SymbolName == SymbolName)
                    {
                        double distance = 0;
                        if (position.TradeType == TradeType.Buy)
                        {
                            distance = Symbol.Bid - position.EntryPrice;
                            if (distance >= DistanceToMoveSLToBE * Symbol.PipSize)
                            {
                                double breakEvenPrice = position.EntryPrice + Symbol.PipSize * 2;
                                ModifyPosition(position, breakEvenPrice, position.TakeProfit);
                                Log($"SL przesunięty do BE+ dla pozycji BUY na poziomie {breakEvenPrice}");
                            }
                        }
                        else if (position.TradeType == TradeType.Sell)
                        {
                            distance = position.EntryPrice - Symbol.Ask;
                            if (distance >= DistanceToMoveSLToBE * Symbol.PipSize)
                            {
                                double breakEvenPrice = position.EntryPrice - Symbol.PipSize * 2;
                                ModifyPosition(position, breakEvenPrice, position.TakeProfit);
                                Log($"SL przesunięty do BE+ dla pozycji SELL na poziomie {breakEvenPrice}");
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas ustawiania stop na poziomie BE", ex);
            }
        }

        private void CloseAllPositions()
        {
            try
            {
                foreach (var position in Positions)
                {
                    if (position.SymbolName == SymbolName)
                    {
                        Log($"Zamykanie pozycji: {position.Label}");
                        ClosePosition(position);
                        Log($"Pozycja zamknięta: {position.Label}");
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas zamykania wszystkich pozycji", ex);
            }
        }

        private void ManageExistingPositions()
        {
            try
            {
                SetTakeProfit();

                if (EnableTrailingStop)
                {
                    SetTrailingStop();
                }
                else if (MoveSLToBE)
                {
                    SetBreakEvenStop();
                }
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas zarządzania istniejącymi pozycjami", ex);
            }
        }

        private string GetLogFilePath()
        {
            string directoryPath = "TrendFollowerLogs";
            if (!System.IO.Directory.Exists(directoryPath))
            {
                System.IO.Directory.CreateDirectory(directoryPath);
            }

            string logFileName = $"TrendFollowerLog_{Server.Time:yyyyMMdd}.txt";
            string logFilePath = System.IO.Path.Combine(directoryPath, logFileName);

            DeleteOldLogFiles(directoryPath, 7);

            return logFilePath;
        }

        private void DeleteOldLogFiles(string directoryPath, int daysToKeep)
        {
            try
            {
                var directoryInfo = new System.IO.DirectoryInfo(directoryPath);
                var oldFiles = directoryInfo.GetFiles()
                                            .Where(file => file.CreationTime < DateTime.Now.AddDays(-daysToKeep));

                foreach (var file in oldFiles)
                {
                    file.Delete();
                }
            }
            catch (Exception ex)
            {
                Print($"Błąd podczas usuwania starych plików logów: {ex.Message}");
            }
        }

        private void Log(string message, [CallerMemberName] string caller = null)
        {
            Print($"{DateTime.Now} [{caller}]: {message}");
            try
            {
                System.IO.File.AppendAllText(_logFilePath, $"{DateTime.Now} [{caller}]: {message}\n");
            }
            catch (Exception ex)
            {
                Print($"Nie udało się zapisać do pliku logu: {ex.Message}");
            }
        }

        private void LogError(string message, Exception ex, [CallerMemberName] string caller = null)
        {
            string errorMessage = $"{DateTime.Now} [{caller}]: {message} - {ex.Message}\nStack Trace: {ex.StackTrace}";
            Print(errorMessage);
            try
            {
                System.IO.File.AppendAllText(_logFilePath, errorMessage + "\n");
            }
            catch (Exception logEx)
            {
                Print($"Nie udało się zapisać do pliku logu: {logEx.Message}");
            }
        }

        private VerticalAlignment GetVerticalAlignment(PanelVerticalPosition position)
        {
            return position switch
            {
                PanelVerticalPosition.Top => VerticalAlignment.Top,
                PanelVerticalPosition.Middle => VerticalAlignment.Center,
                PanelVerticalPosition.Bottom => VerticalAlignment.Bottom,
                _ => VerticalAlignment.Top,
            };
        }

        private HorizontalAlignment GetHorizontalAlignment(PanelHorizontalPosition position)
        {
            return position switch
            {
                PanelHorizontalPosition.Left => HorizontalAlignment.Left,
                PanelHorizontalPosition.Center => HorizontalAlignment.Center,
                PanelHorizontalPosition.Right => HorizontalAlignment.Right,
                _ => HorizontalAlignment.Left,
            };
        }
