        protected override void OnStart()
        {
            try
            {
                InitializeIndicators();

                _initialBalance = Account.Balance;
                _startingDayBalance = _initialBalance;
                _dailyLossLimit = _initialBalance * (DailyLossLimitPercentage / 100);
                _lastTradeTime = DateTime.MinValue;
                _currentDay = Server.Time.Date;
                _globalStopLossTriggered = false;

                _logFilePath = GetLogFilePath();
                Log("Bot uruchomiony.");

                ValidateParameters();
                CreateControlPanel();
            }
            catch (Exception ex)
            {
                LogError("Błąd podczas uruchamiania bota", ex);
            }
        }

